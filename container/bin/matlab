#!/bin/bash
# Translates `matlab -batch <script>` (MATLAB-only syntax) into the Octave
# equivalent, so pathFile.sh's `which matlab` succeeds and M1.sh/M3.sh's
# `$matlab_path -batch info` calls work unmodified.
set -euo pipefail

OCTAVE_BIN="$(command -v octave-cli || command -v octave)"
if [ -z "${OCTAVE_BIN}" ]; then
    echo "matlab-shim: no octave/octave-cli found on PATH" >&2
    exit 127
fi

if [ "${1:-}" = "-batch" ]; then
    shift
    exec "${OCTAVE_BIN}" --no-gui --no-window-system --norc --quiet --eval "${1:-}"
else
    exec "${OCTAVE_BIN}" --no-gui --no-window-system --norc "$@"
fi
